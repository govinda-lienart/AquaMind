<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.5">
  <diagram name="1 - Overview (run order)" id="page-overview">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ov-title" value="AquaMind Pipeline — Overview (run order)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-sub" value="Boxes = stage + which script(s) run, in order. Arrows = what data moves to the next stage. Drill-down detail lives on page 2+, one page per stage." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- Stage 1 -->
        <mxCell id="ov-s1" value="&lt;div style='font-family:Helvetica'&gt;&lt;b&gt;① DATA INGESTION&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#5A3324;margin:2px 0 6px 0'&gt;xlsx + .MOV → MySQL&lt;/div&gt;&lt;hr size='1'/&gt;&lt;div style='font-family:monospace;font-size:11px;text-align:left;margin-top:4px'&gt;1) sync_videos.py&lt;br&gt;2) extract_frames.py&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDB8A8;strokeColor=#A97C63;fontColor=#5A3324;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Stage 2 -->
        <mxCell id="ov-s2" value="&lt;div style='font-family:Helvetica'&gt;&lt;b&gt;② ANNOTATIONS&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#234456;margin:2px 0 6px 0'&gt;LabelStudio bboxes → MySQL&lt;/div&gt;&lt;hr size='1'/&gt;&lt;div style='font-family:monospace;font-size:11px;text-align:left;margin-top:4px'&gt;3) upload_labelstudio.py&lt;br&gt;(label in LabelStudio)&lt;br&gt;4) store_annotations.py&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A9C4D6;strokeColor=#5F86A0;fontColor=#234456;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Stage 3 -->
        <mxCell id="ov-s3" value="&lt;div style='font-family:Helvetica'&gt;&lt;b&gt;③ DATASET PREP&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#37472A;margin:2px 0 6px 0'&gt;MySQL → versioned YOLO set&lt;/div&gt;&lt;hr size='1'/&gt;&lt;div style='font-family:monospace;font-size:11px;text-align:left;margin-top:4px'&gt;5) prepare_dataset.py&lt;br&gt;6) dvc add + push&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9CBA6;strokeColor=#7A9463;fontColor=#37472A;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Stage 4 -->
        <mxCell id="ov-s4" value="&lt;div style='font-family:Helvetica'&gt;&lt;b&gt;④ TRAINING&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#5C4718;margin:2px 0 6px 0'&gt;Fine-tune YOLOv8 on GPU&lt;/div&gt;&lt;hr size='1'/&gt;&lt;div style='font-family:monospace;font-size:11px;text-align:left;margin-top:4px'&gt;7) train.ipynb (Kaggle GPU)&lt;br&gt;8) log_artifact_mlflow.py&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0BE85;strokeColor=#B08B3E;fontColor=#5C4718;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Stage 5 -->
        <mxCell id="ov-s5" value="&lt;div style='font-family:Helvetica'&gt;&lt;b&gt;⑤ MODEL REGISTRY&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#1E3F38;margin:2px 0 6px 0'&gt;Champion resolved for tracker&lt;/div&gt;&lt;hr size='1'/&gt;&lt;div style='font-family:monospace;font-size:11px;text-align:left;margin-top:4px'&gt;9) model_registry.py&lt;br&gt;(called from tracker.py)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8FBBB0;strokeColor=#4F8478;fontColor=#1E3F38;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1160" y="160" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Arrows between stages, labeled with data passed -->
        <mxCell id="ov-e12" value="MySQL: videos, frames" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#444444;labelBackgroundColor=#F5F7F7;" edge="1" parent="1" source="ov-s1" target="ov-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e23" value="MySQL: annotations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#444444;labelBackgroundColor=#F5F7F7;" edge="1" parent="1" source="ov-s2" target="ov-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e34" value="dataset.yaml (DVC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#444444;labelBackgroundColor=#F5F7F7;" edge="1" parent="1" source="ov-s3" target="ov-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e45" value="best.pt + MLflow run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#444444;labelBackgroundColor=#F5F7F7;" edge="1" parent="1" source="ov-s4" target="ov-s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ov-legend" value="&lt;b&gt;How to read this page&lt;/b&gt;&lt;br&gt;Numbers 1–9 inside boxes = the order you actually run things, across the whole pipeline (not per-box).&lt;br&gt;Arrows + labels = the data that moves between stages, not implementation detail.&lt;br&gt;Full script-level detail (config keys, function calls, table columns) lives one page per stage — see tabs below." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8E2E2;fontColor=#4B6167;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1340" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 - Stage 1 Detail (Data Ingestion)" id="page-stage1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0d" />
        <mxCell id="1d" parent="0d" />

        <mxCell id="d1-title" value="Stage ① Data Ingestion — detail" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1d">
          <mxGeometry x="30" y="10" width="600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="d1-runorder" value="&lt;b&gt;Run order:&lt;/b&gt; STEP 1 → STEP 4 below. extract_frames.py will not run against a video that sync_videos.py hasn't registered yet — that's the dashed dependency arrow." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1d">
          <mxGeometry x="30" y="40" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- Inputs -->
        <mxCell id="d1-xlsx" value="video_metadata.xlsx&lt;br&gt;&lt;span style='font-size:10px;color:#777'&gt;manual video metadata&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;size=16;align=center;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1d">
          <mxGeometry x="30" y="90" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d1-mov" value="Video files (.MOV)&lt;br&gt;&lt;span style='font-size:10px;color:#777'&gt;IMG_0350, IMG_2349, ...&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;size=16;align=center;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1d">
          <mxGeometry x="30" y="260" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Scripts -->
        <mxCell id="d1-sync" value="&lt;b&gt;sync_videos.py&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px'&gt;• Read xlsx row by row&lt;br&gt;• Upsert → videos table&lt;br&gt;&amp;nbsp;&amp;nbsp;(register_video())&lt;br&gt;• Log: added/updated/unchanged&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDB8A8;strokeColor=#A97C63;fontColor=#5A3324;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1d">
          <mxGeometry x="290" y="80" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d1-extract" value="&lt;b&gt;extract_frames.py&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px'&gt;• Read config: sample_rate&lt;br&gt;• Guard: video already&lt;br&gt;&amp;nbsp;&amp;nbsp;registered, no duplicates&lt;br&gt;• Extract JPGs → disk&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDB8A8;strokeColor=#A97C63;fontColor=#5A3324;align=center;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1d">
          <mxGeometry x="290" y="250" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- MySQL tables -->
        <mxCell id="d1-videos" value="videos&lt;br&gt;&lt;span style='font-size:10px'&gt;id, file_path, fps,&lt;br&gt;resolution, species, ...&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EDEDED;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1d">
          <mxGeometry x="620" y="70" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d1-frames" value="frames&lt;br&gt;&lt;span style='font-size:10px'&gt;id, video_id (FK),&lt;br&gt;frame_path, frame_number&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EDEDED;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1d">
          <mxGeometry x="620" y="250" width="160" height="110" as="geometry" />
        </mxCell>

        <!-- Edges with explicit STEP order -->
        <mxCell id="d1-e1" value="STEP 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#B8563F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1d" source="d1-xlsx" target="d1-sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1-e2" value="STEP 2 — insert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#B8563F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1d" source="d1-sync" target="d1-videos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1-dep" value="reads registered videos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontFamily=Helvetica;endArrow=open;strokeColor=#B8563F;fontColor=#B8563F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1d" source="d1-videos" target="d1-extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1-e3" value="STEP 3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#B8563F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1d" source="d1-mov" target="d1-extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1-e4" value="STEP 4 — insert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;fontFamily=Helvetica;endArrow=block;strokeColor=#666666;fontColor=#B8563F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1d" source="d1-extract" target="d1-frames">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1-fk" value="video_id FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontFamily=Helvetica;endArrow=open;strokeColor=#999999;fontColor=#999999;labelBackgroundColor=#FFFFFF;" edge="1" parent="1d" source="d1-videos" target="d1-frames">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d1-legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid arrow + STEP n = control flow (run order).&lt;br&gt;Dashed arrow = data dependency, not a run step (nothing to execute).&lt;br&gt;Cylinder = MySQL table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8E2E2;fontColor=#4B6167;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1d">
          <mxGeometry x="30" y="400" width="500" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
